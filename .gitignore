# ==========================================
# 1. 敏感配置与密钥（严禁提交）
# ==========================================
.env
*.local.env

# ==========================================
# 2. Python 编译与虚拟环境
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
mcp-server/venv/

# ==========================================
# 3. 自动化测试与代码质检缓存
# ==========================================
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ==========================================
# 4. 运行时日志与临时文件
# ==========================================
logs/*
!logs/.gitkeep
*.log
mcp-server/*.log
test_sandbox_project/
php_hello_project/
test_php_sandbox/

# ==========================================
# 5. 轨迹与临时大文件
# ==========================================
trajectories/*.jsonl
!trajectories/.gitkeep

# ==========================================
# 6. 编辑器与操作系统杂项
# ==========================================
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/launch.json