# ==========================================
# 1. 敏感配置与个人凭证（严禁提交）
# ==========================================
.env
*.local.env
.env.*
!.env.example

# ==========================================
# 2. Python 编译与虚拟环境
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
mcp-server/venv/

# ==========================================
# 3. 自动化测试与代码质检缓存
# ==========================================
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ==========================================
# 4. Web 隔离沙箱与用户上传目录（新增核心防护）
# ==========================================
workspaces/*
!workspaces/.gitkeep
*.zip
update_temp.zip

# ==========================================
# 5. 遥测中枢与团队数据沉淀（避免上传大文件日志）
# ==========================================
data/telemetry/*.json
!data/telemetry/.gitkeep
dataset_*_team.json
trajectories/*.jsonl
!trajectories/.gitkeep

# ==========================================
# 6. 运行时日志与本地临时沙箱
# ==========================================
logs/*
!logs/.gitkeep
*.log
mcp-server/*.log
test_sandbox_project/
php_hello_project/
test_php_sandbox/

# ==========================================
# 7. 编辑器与操作系统杂项
# ==========================================
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/launch.json